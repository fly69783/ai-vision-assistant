# 复制为 .env 后按需修改；.env 已被 Git 忽略，不能提交真实密钥。
AI_VISION_ENVIRONMENT=development
AI_VISION_HOST=127.0.0.1
AI_VISION_PORT=8000
AI_VISION_LOG_LEVEL=INFO
AI_VISION_MAX_UPLOAD_MB=8
AI_VISION_MAX_IMAGE_PIXELS=25000000

# 本地目标检测与OCR：安装本地AI依赖后改为true。
AI_VISION_DETECTOR_ENABLED=false
AI_VISION_DETECTOR_MIN_CONFIDENCE=0.45
AI_VISION_OCR_ENABLED=false
AI_VISION_OCR_MIN_CONFIDENCE=0.55

# 智谱视觉模型：将false改为true，并把新密钥写在等号后面。
# 不要把真实密钥写进Python、YAML、README或任何会提交到GitHub的文件。
AI_VISION_VISION_ENABLED=false
AI_VISION_VISION_MODEL=glm-4.5v
AI_VISION_ZHIPU_API_KEY=
